{
  "name": "obsidian-notelert-plugin",
  "version": "1.1.10",
  "description": "Automatiza la creación de notificaciones para la app móvil Notelert detectando patrones de fecha/hora en tus notas",
  "main": "lib/main.js",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "plugin",
    "notifications",
    "notelert",
    "mobile",
    "deeplink",
    "automation"
  ],
  "author": "Quim Frances",
  "repository": {
    "type": "git",
    "url": "https://github.com/Joaquim-Frances/obsidian-notelert-plugin.git"
  },
  "scripts": {
    "build": "obsidian-plugin build src/main.ts",
    "build:install": "npm run build && node scripts/copy-to-obsidian.js",
    "dev": "obsidian-plugin dev src/main.ts",
    "watch": "obsidian-plugin dev src/main.ts --watch",
    "install:obsidian": "node scripts/copy-to-obsidian.js",
    "release:assets": "node scripts/create-release-zip.js",
    "release:zip": "node scripts/create-release-zip.js"
  },
  "devDependencies": {
    "obsidian": "obsidianmd/obsidian-api",
    "obsidian-plugin-cli": "^0.4.3",
    "typescript": "^4.1.5"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
